# Copy to .env (development) or set in your host's environment settings. NEVER commit real values.

# --- Server ---------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Public address of this server. Product image links given to the website are built on it.
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated origins allowed to call this API from a browser (the ERP Admin Portal).
CORS_ORIGINS=http://localhost:3000

# --- Auth -----------------------------------------------------------------------
# Comma-separated API keys. Send one as "Authorization: Bearer <key>" or "x-api-key: <key>".
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ERP_API_KEYS=dummy-erp-api-key-change-me-0000000000000000

# --- Database -------------------------------------------------------------------
# The SAME MongoDB the FunkyKidz website uses — products written here are what the shop shows.
# The database name comes from the connection string (or MONGODB_DB if set).
MONGODB_URI=mongodb://127.0.0.1:27017/funkykidz
MONGODB_DB=
MONGODB_MAX_POOL_SIZE=50

# --- Cloudflare R2 (product images) -----------------------------------------------
# Cloudflare R2 (S3-compatible) — R2 → Manage API tokens → access key id / secret.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=funkykidz
# Folder in the bucket for product images (must match on the backend and the website).
CLOUDFLARE_R2_IMAGE_FOLDER=products
# https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
# Signed (presigned) image URLs live this long (seconds). Capped at 1200 (20 minutes).
CLOUDFLARE_SIGNED_URL_TTL=1200

# --- Website sync ---------------------------------------------------------------
# Called after every product change so the shop drops its cached catalogue immediately.
# Leave empty to rely on the website's own 60-second refresh.
WEBSITE_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Must equal REVALIDATE_SECRET in the website's environment.
WEBSITE_REVALIDATE_SECRET=dummy-revalidate-secret-change-me-000000

# --- Google Gemini (AI product details from a photo) -------------------------------
# Key from https://aistudio.google.com/apikey (the free tier covers the analysis models).
GEMINI_API_KEY=
# Vision models for product analysis, tried in order (fallback when one is overloaded).
GEMINI_ANALYSIS_MODELS=gemini-3.8-flash,gemini-3.5-flash
GEMINI_TIMEOUT_MS=120000

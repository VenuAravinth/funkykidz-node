{
  "name": "funkykidz-erp-backend",
  "version": "1.0.0",
  "description": "FunkyKidz ERP Admin Portal API (Fastify + MongoDB)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "check": "node --check src/server.js",
    "build": "node --check src/server.js && node --check api/index.js"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "fastify": "^5.12.7",
    "mongodb": "^6.21.0"
  }
}
